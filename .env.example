# Variables d'environnement — copier en .env et ne jamais committer .env

# Backend
DATABASE_URL=postgresql://portfolio:changeme@db:5432/portfolio
PORT=3000

# Frontend
PUBLIC_API_URL=http://localhost:3000

# PostgreSQL (utilisé par le service db dans docker-compose)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=changeme
POSTGRES_DB=portfolio

# Email (pour le formulaire de contact — à configurer)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# CONTACT_EMAIL=
