---
interface Props { lang?: 'fr' | 'en'; }
const { lang = 'fr' } = Astro.props;
const isEn = lang === 'en';

const resultsFr = [
  { value: '2 172', title: 'services réseau', label: 'accessibles par les agents via des outils contrôlés' },
  { value: '< 6 s', title: 'de latence médiane', label: 'mesurée dans l’environnement de démonstration' },
  { value: '4 analyses', title: 'réunies dans une même étude', label: 'chemin, capacité, équipements et qualité du signal' },
  { value: '1 rapport', title: 'prêt à être vérifié', label: 'avec la décision, les données utilisées et les résultats de simulation' },
];

const resultsEn = [
  { value: '2,172', title: 'network services', label: 'accessible through controlled agent tools' },
  { value: '< 6 s', title: 'median latency', label: 'measured in the demonstration environment' },
  { value: '4 analyses', title: 'combined in one study', label: 'route, capacity, equipment and signal quality' },
  { value: '1 report', title: 'ready for review', label: 'including the decision, supporting data and simulation results' },
];

const demosFr = [
  {
    title: 'Explorer la topologie',
    label: 'Cartographie réseau',
    description: 'Visualisation interactive des liaisons, filtrage par zone et lecture de la capacité encore disponible sur chaque liaison.',
    observe: 'À observer : la carte rend visibles les chemins possibles et la capacité disponible avant toute analyse.',
    video: '/media/topology-map.mp4',
    poster: '/media/topology-map.webp',
    playbackRate: 1,
  },
  {
    title: 'Interroger le réseau',
    label: 'Assistant IA',
    description: 'Une question métier en langage naturel est routée vers les agents et les sources appropriées.',
    observe: 'À observer : la question est comprise, puis confiée aux outils et aux données adaptés.',
    video: '/media/andiamo-question.mp4',
    poster: '/media/andiamo-question.webp',
    playbackRate: 1,
  },
  {
    title: 'Étudier une faisabilité',
    label: 'Parcours complet',
    description: 'Choix du chemin, sélection des équipements, simulation de la qualité du signal puis génération d’un rapport de décision.',
    observe: 'À observer : les quatre analyses sont réunies dans un rapport qui justifie la décision finale.',
    video: '/media/feasibility.mp4',
    poster: '/media/feasibility.webp',
    playbackRate: 1.35,
  },
];

const demosEn = [
  { title: 'Explore the topology', label: 'Network map', description: 'Interactive view of the links, regional filters and remaining capacity on each connection.', observe: 'What to notice: the map exposes possible routes and available capacity before the analysis starts.', video: '/media/topology-map.mp4', poster: '/media/topology-map.webp', playbackRate: 1 },
  { title: 'Query the network', label: 'AI assistant', description: 'A business question written in natural language is routed to the right agents and data sources.', observe: 'What to notice: the question is interpreted, then assigned to the appropriate data and engineering tools.', video: '/media/andiamo-question.mp4', poster: '/media/andiamo-question.webp', playbackRate: 1 },
  { title: 'Run a feasibility study', label: 'End-to-end workflow', description: 'Route selection, equipment choice, signal-quality simulation and generation of a decision report.', observe: 'What to notice: all four analyses are combined in a report that supports the final decision.', video: '/media/feasibility.mp4', poster: '/media/feasibility.webp', playbackRate: 1.35 },
];

const contributionsFr = [
  { title: 'Concevoir', text: 'Routeur conversationnel et orchestration multi-agents.', tags: ['LangGraph', 'Architecture'] },
  { title: 'Connecter', text: 'Accès aux données réseau et aux outils d’ingénierie.', tags: ['MCP', 'GraphQL', 'PostgreSQL'] },
  { title: 'Fiabiliser', text: 'Validation, traçabilité et sorties structurées.', tags: ['Contrôles', 'Qualité'] },
  { title: 'Livrer', text: 'Interface de démonstration et rapports automatiques.', tags: ['UI', 'Reporting'] },
];

const contributionsEn = [
  { title: 'Design', text: 'Conversational router and multi-agent orchestration.', tags: ['LangGraph', 'Architecture'] },
  { title: 'Connect', text: 'Access to network data and engineering tools.', tags: ['MCP', 'GraphQL', 'PostgreSQL'] },
  { title: 'Make reliable', text: 'Validation, traceability and structured outputs.', tags: ['Controls', 'Quality'] },
  { title: 'Deliver', text: 'Demonstration interface and automated reports.', tags: ['UI', 'Reporting'] },
];

const reliabilityFr = [
  { title: 'Accès contrôlé aux données', text: 'Les agents accèdent uniquement aux outils et aux sources de données approuvés.' },
  { title: 'Calculs déterministes', text: 'Les calculs d’ingénierie sont confiés à des outils Python spécialisés et à GNPy.' },
  { title: 'Résultats traçables', text: 'Le rapport expose le chemin, la capacité, les équipements et les simulations qui justifient la décision.' },
];

const reliabilityEn = [
  { title: 'Controlled data access', text: 'Agents can only access approved tools and data sources.' },
  { title: 'Deterministic calculations', text: 'Engineering calculations are delegated to specialized Python tools and GNPy.' },
  { title: 'Traceable outputs', text: 'The final report exposes the route, capacity, equipment and simulation results supporting the decision.' },
];

const decisionsFr = [
  { title: 'Pourquoi LangGraph ?', text: 'J’ai d’abord testé n8n, puis retenu LangGraph pour sa gestion plus modulaire de l’état des agents, son routage conditionnel et la possibilité d’ajouter une logique de validation sur mesure.' },
  { title: 'Pourquoi MCP ?', text: 'MCP fournit une interface cohérente entre les agents et des outils hétérogènes comme les bases de données, les API et le logiciel de simulation.' },
  { title: 'Quelle a été la principale difficulté ?', text: 'Le principal défi n’était pas de générer du texte, mais de fournir aux agents des données opérationnelles fiables et à jour, puis de garantir que chaque résultat reste techniquement vérifiable.' },
];

const decisionsEn = [
  { title: 'Why LangGraph?', text: 'I first tested n8n, then selected LangGraph because the project required more modular agent state management, conditional routing and custom validation logic.' },
  { title: 'Why MCP?', text: 'MCP provided a consistent interface between the agents and heterogeneous tools such as databases, APIs and simulation software.' },
  { title: 'What was hardest?', text: 'The main challenge was not generating text, but providing agents with reliable, up-to-date operational data and ensuring that every result remained technically verifiable.' },
];

const results = isEn ? resultsEn : resultsFr;
const demos = isEn ? demosEn : demosFr;
const contributions = isEn ? contributionsEn : contributionsFr;
const reliability = isEn ? reliabilityEn : reliabilityFr;
const decisions = isEn ? decisionsEn : decisionsFr;
const reportHref = isEn ? '/media/feasibility-report-en.html' : '/media/feasibility-report.html';
const alternateReportHref = isEn ? '/media/feasibility-report.html' : '/media/feasibility-report-en.html';
const copy = isEn ? {
  eyebrow: 'Case study at Orange Innovation', intro: 'I designed Andiamo, a conversational assistant for querying Orange optical-network data in natural language. A feasibility request automatically triggers the complete engineering analysis and report generation.',
  problem: 'Before', problemText: 'Engineers had to move between separate tools to cross-check topology, inventory, services and capacity.',
  solution: 'With Andiamo', solutionText: 'One conversation answers everyday questions and launches the full feasibility workflow when needed.',
  contribution: 'My contribution', contributionText: 'From architecture to a demonstrable product.',
  context: 'Project context', contextText: 'Final-year internship at Orange Innovation. Demonstrations use anonymized data; source code and internal datasets remain Orange property.',
  chatLabel: 'How the assistant is used', chatPrompt: 'Ask in natural language', chatQuestionOne: 'Which services use this network link?', chatQuestionTwo: 'Can this new optical connection be deployed?', chatRouter: 'Andiamo identifies the intent', chatAnswer: 'Network answer', chatAnswerText: 'Topology · Inventory · Services · Capacity', chatWorkflow: 'Feasibility workflow', chatWorkflowText: 'Route · Equipment · Signal · Report',
  demos: 'Demos', demosTitle: 'See the workflow in action.', demosText: 'Short extracts from an internal engineering prototype. All visible data has been anonymized.',
  report: 'Generated report', reportTitle: 'The final decision, with the evidence needed to review it.', reportText: 'The English report summarizes the selected route, available capacity, required equipment and signal-quality simulation. The original detailed report remains available in French.', reportCta: 'Open the English report', reportOriginalCta: 'View the original French report', reportFrame: 'English feasibility report generated by Andiamo Agent',
  architectureTitle: 'One assistant, two response paths.', architectureText: 'The router selects either a direct data answer or a verified engineering workflow.', flow: 'From a network question to the right level of analysis',
  question: 'Network question', questionText: 'Topology, inventory, services, capacity or feasibility', agents: 'Router and agents', network: 'Network data', route: 'Engineering tools', simulation: 'GNPy simulation', answer: 'Answer or report', answerText: 'Operational answer or verified feasibility report',
  reliability: 'Reliability by design', reliabilityText: 'The LLM coordinates approved tools; it does not perform the engineering calculations itself.',
  decisions: 'Key engineering decisions', decisionsText: 'The main technical choices and the problem that required the most care.',
} : {
  eyebrow: 'Étude de cas chez Orange Innovation', intro: 'J’ai conçu Andiamo, un assistant conversationnel pour interroger en langage naturel les données du réseau optique d’Orange. Une demande de faisabilité déclenche automatiquement l’analyse d’ingénierie complète et la génération du rapport.',
  problem: 'Avant', problemText: 'Les ingénieurs passaient d’un outil à l’autre pour croiser topologie, inventaire, services et capacité.',
  solution: 'Avec Andiamo', solutionText: 'Une conversation répond aux questions courantes et lance l’étude de faisabilité complète quand elle est nécessaire.',
  contribution: 'Ma contribution', contributionText: 'De l’architecture au produit démontrable.',
  context: 'Contexte du projet', contextText: 'Stage de fin d’études chez Orange Innovation. Démonstrations sur données anonymisées ; le code et les données internes restent la propriété d’Orange.',
  chatLabel: 'Comment utiliser l’assistant', chatPrompt: 'Question en langage naturel', chatQuestionOne: 'Quels services utilisent cette liaison ?', chatQuestionTwo: 'Cette nouvelle liaison optique est-elle réalisable ?', chatRouter: 'Andiamo identifie l’intention', chatAnswer: 'Réponse réseau', chatAnswerText: 'Topologie · Inventaire · Services · Capacité', chatWorkflow: 'Étude de faisabilité', chatWorkflowText: 'Chemin · Équipements · Signal · Rapport',
  demos: 'Démonstrations', demosTitle: 'Voir le parcours en action.', demosText: 'Extraits courts d’un prototype d’ingénierie interne. Toutes les données visibles sont anonymisées.',
  report: 'Rapport généré', reportTitle: 'La décision finale, accompagnée des éléments nécessaires pour la vérifier.', reportText: 'Le rapport rassemble le chemin retenu, la capacité disponible, les équipements nécessaires et la simulation de la qualité du signal.', reportCta: 'Ouvrir le rapport français', reportOriginalCta: 'Voir la synthèse anglaise', reportFrame: 'Rapport français de faisabilité généré par Andiamo Agent',
  architectureTitle: 'Un assistant, deux parcours de réponse.', architectureText: 'Le routeur sélectionne soit une réponse directe issue des données, soit un workflow d’ingénierie vérifié.', flow: 'De la question réseau au bon niveau d’analyse',
  question: 'Question réseau', questionText: 'Topologie, inventaire, services, capacité ou faisabilité', agents: 'Routeur et agents', network: 'Données réseau', route: 'Outils d’ingénierie', simulation: 'Simulation GNPy', answer: 'Réponse ou rapport', answerText: 'Réponse opérationnelle ou rapport de faisabilité vérifié',
  reliability: 'Fiabilité dès la conception', reliabilityText: 'Le modèle coordonne des outils approuvés ; il n’effectue pas lui-même les calculs d’ingénierie.',
  decisions: 'Choix techniques clés', decisionsText: 'Les principales décisions d’architecture et la difficulté qui a demandé le plus de rigueur.',
};
---

<section id="orange-case-study" class="border-b border-blue-100 bg-white px-6 py-24 text-slate-950 lg:px-10 lg:py-32">
  <div class="mx-auto max-w-7xl">
    <div class="grid items-start gap-12 lg:grid-cols-[.78fr_1.22fr] lg:gap-20">
      <div>
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-blue-600">{copy.eyebrow}</p>
        <h2 class="mt-5 text-4xl font-semibold leading-tight tracking-[-0.035em] sm:text-5xl">Andiamo Agent</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">
          {copy.intro}
        </p>
        <div class="mt-8 grid gap-3">
          <article class="grid grid-cols-[auto_1fr] gap-4 rounded-2xl border border-slate-200 bg-slate-50 p-5">
            <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-400">01</span>
            <div>
              <p class="text-sm font-semibold text-slate-800">{copy.problem}</p>
              <p class="mt-1 text-sm leading-relaxed text-slate-500">{copy.problemText}</p>
            </div>
          </article>
          <article class="grid grid-cols-[auto_1fr] gap-4 rounded-2xl border border-blue-200 bg-blue-50 p-5">
            <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-blue-500">02</span>
            <div>
              <p class="text-sm font-semibold text-blue-800">{copy.solution}</p>
              <p class="mt-1 text-sm leading-relaxed text-slate-600">{copy.solutionText}</p>
            </div>
          </article>
        </div>
      </div>

      <div class="overflow-hidden rounded-[1.75rem] border border-blue-100 bg-[#f8fbff] shadow-2xl shadow-blue-950/10">
        <div class="flex items-center justify-between border-b border-blue-100 bg-white px-5 py-4">
          <div class="flex items-center gap-3">
            <span class="grid h-9 w-9 place-items-center rounded-xl bg-blue-600 font-mono text-[10px] font-semibold text-white">AN</span>
            <div>
              <p class="text-sm font-semibold text-slate-950">Andiamo</p>
              <p class="text-xs text-slate-400">{copy.chatLabel}</p>
            </div>
          </div>
          <span class="flex items-center gap-2 text-xs text-emerald-600"><span class="h-2 w-2 rounded-full bg-emerald-500"></span>Online</span>
        </div>
        <div class="p-5 sm:p-7">
          <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-400">{copy.chatPrompt}</p>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            <div class="rounded-2xl rounded-tr-sm bg-white p-4 text-sm font-medium text-slate-700 shadow-sm ring-1 ring-blue-100">“{copy.chatQuestionOne}”</div>
            <div class="rounded-2xl rounded-tr-sm bg-white p-4 text-sm font-medium text-slate-700 shadow-sm ring-1 ring-blue-100">“{copy.chatQuestionTwo}”</div>
          </div>

          <div class="relative my-6 flex items-center justify-center">
            <span class="absolute inset-x-0 h-px bg-blue-100"></span>
            <span class="relative rounded-full border border-blue-200 bg-white px-4 py-2 text-xs font-semibold text-blue-700 shadow-sm">{copy.chatRouter}</span>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            <div class="relative overflow-hidden rounded-2xl border border-cyan-200 bg-cyan-50 p-5">
              <span class="absolute right-4 top-3 font-mono text-4xl font-semibold text-cyan-200/70">01</span>
              <span class="inline-block h-2 w-8 rounded-full bg-cyan-500"></span>
              <p class="mt-4 font-semibold text-slate-950">{copy.chatAnswer}</p>
              <p class="mt-2 text-xs leading-relaxed text-slate-500">{copy.chatAnswerText}</p>
            </div>
            <div class="relative overflow-hidden rounded-2xl border border-blue-200 bg-blue-600 p-5 text-white shadow-lg shadow-blue-600/15">
              <span class="absolute right-4 top-3 font-mono text-4xl font-semibold text-white/15">02</span>
              <span class="inline-block h-2 w-8 rounded-full bg-cyan-300"></span>
              <p class="mt-4 font-semibold">{copy.chatWorkflow}</p>
              <p class="mt-2 text-xs leading-relaxed text-blue-100">{copy.chatWorkflowText}</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-16">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-blue-600">{copy.contribution}</p>
        <h3 class="text-2xl font-semibold tracking-tight text-slate-950">{copy.contributionText}</h3>
      </div>
      <ol class="mt-7 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {contributions.map((item, index) => (
          <li class="group relative min-h-48 overflow-hidden rounded-2xl border border-blue-100 bg-[#f8fbff] p-6 transition hover:-translate-y-1 hover:border-blue-300 hover:bg-white hover:shadow-xl hover:shadow-blue-950/5">
            <span class="absolute -right-1 -top-4 font-mono text-7xl font-semibold text-blue-100 transition group-hover:text-cyan-100">0{index + 1}</span>
            <span class="relative inline-block h-1.5 w-10 rounded-full bg-blue-600"></span>
            <h4 class="relative mt-7 text-xl font-semibold text-slate-950">{item.title}</h4>
            <p class="relative mt-2 text-sm leading-relaxed text-slate-500">{item.text}</p>
            <div class="relative mt-5 flex flex-wrap gap-1.5">
              {item.tags.map((tag) => <span class="rounded-full border border-blue-100 bg-white px-2.5 py-1 font-mono text-[10px] text-blue-700">{tag}</span>)}
            </div>
          </li>
        ))}
      </ol>
    </div>

    <aside class="mt-8 flex flex-col gap-2 border-l-2 border-blue-500 pl-4 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.18em] text-blue-600">{copy.context}</p>
      <p class="max-w-4xl text-xs leading-relaxed text-slate-500">{copy.contextText}</p>
    </aside>

    <div class="mt-16 grid gap-px overflow-hidden rounded-2xl border border-blue-100 bg-blue-100 sm:grid-cols-2 lg:grid-cols-4">
      {results.map((result) => (
        <div class="bg-white p-6 sm:p-7">
          <p class="text-3xl font-semibold tracking-tight text-slate-950">{result.value}</p>
          <p class="mt-2 text-sm font-semibold text-slate-700">{result.title}</p>
          <p class="mt-1 text-sm leading-relaxed text-slate-500">{result.label}</p>
        </div>
      ))}
    </div>
    <div class="mt-24">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-blue-600">{copy.demos}</p>
          <h3 class="mt-4 text-3xl font-semibold tracking-[-0.03em] sm:text-4xl">{copy.demosTitle}</h3>
        </div>
        <p class="max-w-md text-sm leading-relaxed text-slate-500">
          {copy.demosText}
        </p>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {demos.map((demo, index) => (
          <article class="group overflow-hidden rounded-2xl border border-blue-100 bg-white shadow-sm transition hover:-translate-y-1 hover:border-blue-300 hover:shadow-xl hover:shadow-blue-900/5">
            <div class="relative aspect-[16/9] overflow-hidden bg-black">
              <video
                class="h-full w-full object-cover opacity-85 transition duration-500 group-hover:opacity-100"
                controls
                muted
                playsinline
                preload="none"
                poster={demo.poster}
                data-playback-rate={demo.playbackRate}
                aria-label={`${isEn ? 'Demo' : 'Démonstration'} : ${demo.title}`}
              >
                <source src={demo.video} type="video/mp4" />
              </video>
              <span class="pointer-events-none absolute left-4 top-4 rounded-full border border-white/15 bg-black/70 px-3 py-1 font-mono text-[10px] uppercase tracking-[0.16em] text-zinc-300 backdrop-blur">
                0{index + 1} / {demo.label}
              </span>
            </div>
            <div class="p-6">
              <h4 class="text-lg font-semibold text-slate-950">{demo.title}</h4>
              <p class="mt-2 text-sm leading-relaxed text-slate-500">{demo.description}</p>
              <p class="mt-4 border-l-2 border-cyan-400 pl-3 text-xs leading-relaxed text-slate-600">{demo.observe}</p>
            </div>
          </article>
        ))}
      </div>

    </div>

    <div class="mt-24 grid gap-6 lg:grid-cols-[.9fr_1.1fr]">
      <div class="rounded-2xl border border-blue-100 bg-blue-50 p-7 sm:p-9">
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-blue-600">Architecture</p>
        <h3 class="mt-4 text-2xl font-semibold tracking-tight">{copy.architectureTitle}</h3>
        <p class="mt-4 leading-relaxed text-slate-600">
          {copy.architectureText}
        </p>
      </div>
      <div class="rounded-2xl border border-blue-100 bg-white p-5 shadow-xl shadow-blue-900/5 sm:p-7">
        <p class="mb-6 text-sm font-medium text-slate-500">{copy.flow}</p>
        <div class="grid items-stretch gap-3 sm:grid-cols-[1fr_auto_1.25fr_auto_1.1fr]">
          <div class="rounded-xl border border-cyan-200 bg-cyan-50 p-4">
            <span class="grid h-8 w-8 place-items-center rounded-full bg-cyan-500 font-mono text-xs font-semibold text-white">01</span>
            <p class="mt-4 font-semibold text-slate-950">{copy.question}</p>
            <p class="mt-1 text-xs leading-relaxed text-slate-500">{copy.questionText}</p>
          </div>
          <span class="hidden self-center text-xl text-blue-300 sm:block">→</span>
          <div class="rounded-xl border border-blue-200 bg-blue-50 p-4">
            <span class="grid h-8 w-8 place-items-center rounded-full bg-blue-600 font-mono text-xs font-semibold text-white">02</span>
            <p class="mt-4 font-semibold text-slate-950">{copy.agents}</p>
            <div class="mt-3 flex flex-wrap gap-1.5 text-[11px] text-blue-700">
              <span class="rounded-full bg-white px-2.5 py-1">{copy.network}</span>
              <span class="rounded-full bg-white px-2.5 py-1">{copy.route}</span>
              <span class="rounded-full bg-white px-2.5 py-1">{copy.simulation}</span>
            </div>
          </div>
          <span class="hidden self-center text-xl text-blue-300 sm:block">→</span>
          <div class="grid gap-2">
            <div class="rounded-xl border border-cyan-200 bg-cyan-50 p-4">
              <p class="font-semibold text-slate-950">{copy.chatAnswer}</p>
              <p class="mt-1 text-xs leading-relaxed text-slate-500">{copy.chatAnswerText}</p>
            </div>
            <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4">
              <p class="font-semibold text-slate-950">{copy.chatWorkflow}</p>
              <p class="mt-1 text-xs leading-relaxed text-slate-500">{copy.chatWorkflowText}</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <section class="mt-24 rounded-3xl bg-slate-950 p-7 text-white sm:p-10">
      <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:gap-16">
        <div>
          <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-cyan-300">{copy.reliability}</p>
          <h3 class="mt-4 text-3xl font-semibold tracking-[-0.03em]">{isEn ? 'The model coordinates. Engineering tools decide.' : 'Le modèle coordonne. Les outils d’ingénierie calculent.'}</h3>
          <p class="mt-5 leading-relaxed text-slate-300">{copy.reliabilityText}</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          {reliability.map((item, index) => (
            <article class="rounded-2xl border border-white/10 bg-white/5 p-5">
              <span class="font-mono text-xs text-cyan-300">0{index + 1}</span>
              <h4 class="mt-4 font-semibold text-white">{item.title}</h4>
              <p class="mt-2 text-sm leading-relaxed text-slate-300">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="mt-24">
      <div class="max-w-3xl">
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-blue-600">{copy.decisions}</p>
        <h3 class="mt-4 text-3xl font-semibold tracking-[-0.03em] sm:text-4xl">{copy.decisionsText}</h3>
      </div>
      <div class="mt-10 grid gap-3 lg:grid-cols-3">
        {decisions.map((item) => (
          <details class="group rounded-2xl border border-blue-100 bg-[#f8fbff] p-6 open:border-blue-300 open:bg-white open:shadow-lg open:shadow-blue-950/5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold text-slate-950">
              {item.title}
              <span class="grid h-8 w-8 flex-none place-items-center rounded-full border border-blue-200 bg-white text-blue-600 transition group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 border-t border-blue-100 pt-4 text-sm leading-relaxed text-slate-600">{item.text}</p>
          </details>
        ))}
      </div>
    </section>

    <article class="mt-24 overflow-hidden rounded-3xl border border-blue-100 bg-[#f8fbff] shadow-xl shadow-blue-900/5">
      <div class="flex flex-col gap-7 border-b border-blue-100 p-7 lg:flex-row lg:items-end lg:justify-between sm:p-9">
        <div>
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-blue-600">{copy.report}</p>
          <h3 class="mt-3 max-w-2xl text-2xl font-semibold tracking-tight text-slate-950 sm:text-3xl">{copy.reportTitle}</h3>
          <p class="mt-4 max-w-2xl text-sm leading-relaxed text-slate-600">{copy.reportText}</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={reportHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-full bg-blue-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-blue-700">
            {copy.reportCta} <span>↗</span>
          </a>
          <a href={alternateReportHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-full border border-blue-200 bg-white px-5 py-3 text-sm font-semibold text-blue-700 transition hover:border-blue-400">
            {copy.reportOriginalCta}
          </a>
        </div>
      </div>
      <div class="bg-slate-200 p-3 sm:p-5">
        <div class="overflow-hidden rounded-2xl border border-slate-300 bg-white shadow-inner">
          <iframe
            src={reportHref}
            title={copy.reportFrame}
            class="h-[620px] w-full bg-white"
            loading="lazy"
            sandbox="allow-scripts"
            referrerpolicy="no-referrer"
          ></iframe>
        </div>
      </div>
    </article>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLVideoElement>('video[data-playback-rate]').forEach((video) => {
    const rate = Number(video.dataset.playbackRate || '1');
    video.defaultPlaybackRate = rate;
    video.playbackRate = rate;
  });
</script>
