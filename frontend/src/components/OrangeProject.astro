---
interface Props { lang?: 'fr' | 'en'; }
const { lang = 'fr' } = Astro.props;
const isEn = lang === 'en';

const resultsFr = [
  { value: '1 demande', label: 'pour passer d’une question à un rapport technique complet' },
  { value: '< 6 s', label: 'pour obtenir une réponse exploitable' },
  { value: '2 172', label: 'services réseau consultables en langage naturel' },
  { value: '4 volets', label: 'chemin, capacité, équipements et qualité du signal' },
];

const resultsEn = [
  { value: '1 request', label: 'to go from a question to a complete technical report' },
  { value: '< 6 s', label: 'to produce an actionable answer' },
  { value: '2,172', label: 'network services accessible in natural language' },
  { value: '4 sections', label: 'route, capacity, equipment and signal quality' },
];

const demosFr = [
  {
    title: 'Explorer la topologie',
    label: 'Cartographie réseau',
    description: 'Visualisation interactive des liaisons, filtrage par zone et lecture de la capacité encore disponible sur chaque liaison.',
    video: '/media/topology-map.mp4',
    poster: '/media/topology-map.webp',
    playbackRate: 1,
  },
  {
    title: 'Interroger le réseau',
    label: 'Assistant IA',
    description: 'Une question métier en langage naturel est routée vers les agents et les sources appropriées.',
    video: '/media/andiamo-question.mp4',
    poster: '/media/andiamo-question.webp',
    playbackRate: 1,
  },
  {
    title: 'Étudier une faisabilité',
    label: 'Parcours complet',
    description: 'Choix du chemin, sélection des équipements, simulation de la qualité du signal puis génération d’un rapport de décision.',
    video: '/media/feasibility.mp4',
    poster: '/media/feasibility.webp',
    playbackRate: 1.35,
  },
];

const demosEn = [
  { title: 'Explore the topology', label: 'Network map', description: 'Interactive view of the links, regional filters and remaining capacity on each connection.', video: '/media/topology-map.mp4', poster: '/media/topology-map.webp', playbackRate: 1 },
  { title: 'Query the network', label: 'AI assistant', description: 'A business question written in natural language is routed to the right agents and data sources.', video: '/media/andiamo-question.mp4', poster: '/media/andiamo-question.webp', playbackRate: 1 },
  { title: 'Run a feasibility study', label: 'End-to-end workflow', description: 'Route selection, equipment choice, signal-quality simulation and generation of a decision report.', video: '/media/feasibility.mp4', poster: '/media/feasibility.webp', playbackRate: 1.35 },
];

const results = isEn ? resultsEn : resultsFr;
const demos = isEn ? demosEn : demosFr;
const copy = isEn ? {
  eyebrow: 'Case study at Orange Innovation', intro: 'A conversational AI assistant for operating and planning a long-haul optical network, the infrastructure that carries data between cities and countries.',
  problem: 'The problem', problemText: 'Checking whether a new connection was feasible required several tools: finding the best route, checking available capacity, simulating the signal and verifying equipment. The analysis could take several hours.',
  solution: 'The solution', solutionText: 'A LangGraph orchestration engine coordinates several specialized AI agents. They query network data, calculate routes and use GNPy, software that simulates optical signal quality, before producing a shareable report.',
  demos: 'Demos', demosTitle: 'A few examples on video.', demosText: 'Short extracts from a demonstration environment. All visible data has been anonymized.',
  report: 'Generated report', reportTitle: 'The final decision, presented in a document teams can use.', reportText: 'The report brings together the selected route, available capacity, required equipment and the signal-quality simulation.', reportCta: 'Open the full report', reportFrame: 'Preview of the feasibility report generated by Andiamo Agent',
  architectureTitle: 'How it works.', architectureText: 'The router selects the appropriate agent. Each agent has its own tools and data sources. A quality judge checks the response before it is returned.', flow: 'From a business request to a verified result',
  question: 'Business question', questionText: 'Written naturally by the user', agents: 'Agents and tools', network: 'Network data', route: 'Route calculation', simulation: 'GNPy simulation', answer: 'Verified response', answerText: 'Clear decision and detailed report',
} : {
  eyebrow: 'Étude de cas chez Orange Innovation', intro: 'Un assistant IA conversationnel pour exploiter et planifier un réseau optique longue distance, celui qui transporte les données entre plusieurs villes ou pays.',
  problem: 'Le problème', problemText: 'Vérifier qu’une nouvelle liaison était réalisable nécessitait plusieurs outils : recherche du meilleur chemin, contrôle de la capacité disponible, simulation du signal et vérification des équipements. L’analyse pouvait prendre plusieurs heures.',
  solution: 'La solution', solutionText: 'Un moteur d’orchestration (LangGraph) coordonne plusieurs agents IA spécialisés. Ils consultent les données du réseau, calculent les chemins et utilisent GNPy, un logiciel qui simule la qualité du signal optique, avant de produire un rapport partageable.',
  demos: 'Démonstrations', demosTitle: 'Quelques exemples en vidéo.', demosText: 'Extraits courts d’un environnement de démonstration. Toutes les données visibles sont anonymisées.',
  report: 'Rapport généré', reportTitle: 'La décision finale, présentée dans un document exploitable.', reportText: 'Le rapport rassemble le chemin retenu, la capacité disponible, les équipements nécessaires et la simulation de la qualité du signal.', reportCta: 'Ouvrir le rapport complet', reportFrame: 'Aperçu du rapport de faisabilité généré par Andiamo Agent',
  architectureTitle: 'Comment ça fonctionne.', architectureText: 'Le routeur choisit l’agent compétent. Chaque agent dispose de ses propres outils et sources de données. Un juge de qualité vérifie ensuite la réponse avant restitution.', flow: 'Du besoin exprimé au résultat vérifié',
  question: 'Question métier', questionText: 'Formulée simplement par l’utilisateur', agents: 'Agents et outils', network: 'Données réseau', route: 'Calcul du chemin', simulation: 'Simulation GNPy', answer: 'Réponse vérifiée', answerText: 'Décision claire et rapport détaillé',
};
---

<section id="orange-case-study" class="border-b border-blue-100 bg-white px-6 py-24 text-slate-950 lg:px-10 lg:py-32">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-12 lg:grid-cols-[.72fr_1.28fr] lg:gap-20">
      <div>
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-blue-600">{copy.eyebrow}</p>
        <h2 class="mt-5 text-4xl font-semibold leading-tight tracking-[-0.035em] sm:text-5xl">Andiamo Agent</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">
          {copy.intro}
        </p>
      </div>

      <div class="grid gap-8 sm:grid-cols-2">
        <article class="rounded-2xl border border-blue-100 bg-slate-50 p-6">
          <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-slate-500">{copy.problem}</span>
          <p class="mt-4 leading-relaxed text-slate-700">
            {copy.problemText}
          </p>
        </article>
        <article class="rounded-2xl border border-blue-200 bg-blue-50 p-6">
          <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-blue-600">{copy.solution}</span>
          <p class="mt-4 leading-relaxed text-slate-700">
            {copy.solutionText}
          </p>
        </article>
      </div>
    </div>

    <div class="mt-16 grid gap-px overflow-hidden rounded-2xl border border-blue-100 bg-blue-100 sm:grid-cols-2 lg:grid-cols-4">
      {results.map((result) => (
        <div class="bg-white p-6 sm:p-7">
          <p class="text-3xl font-semibold tracking-tight text-slate-950">{result.value}</p>
          <p class="mt-2 text-sm leading-relaxed text-slate-500">{result.label}</p>
        </div>
      ))}
    </div>
    <div class="mt-24">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-blue-600">{copy.demos}</p>
          <h3 class="mt-4 text-3xl font-semibold tracking-[-0.03em] sm:text-4xl">{copy.demosTitle}</h3>
        </div>
        <p class="max-w-md text-sm leading-relaxed text-slate-500">
          {copy.demosText}
        </p>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {demos.map((demo, index) => (
          <article class="group overflow-hidden rounded-2xl border border-blue-100 bg-white shadow-sm transition hover:-translate-y-1 hover:border-blue-300 hover:shadow-xl hover:shadow-blue-900/5">
            <div class="relative aspect-[16/9] overflow-hidden bg-black">
              <video
                class="h-full w-full object-cover opacity-85 transition duration-500 group-hover:opacity-100"
                controls
                muted
                playsinline
                preload="none"
                poster={demo.poster}
                data-playback-rate={demo.playbackRate}
                aria-label={`${isEn ? 'Demo' : 'Démonstration'} : ${demo.title}`}
              >
                <source src={demo.video} type="video/mp4" />
              </video>
              <span class="pointer-events-none absolute left-4 top-4 rounded-full border border-white/15 bg-black/70 px-3 py-1 font-mono text-[10px] uppercase tracking-[0.16em] text-zinc-300 backdrop-blur">
                0{index + 1} / {demo.label}
              </span>
            </div>
            <div class="p-6">
              <h4 class="text-lg font-semibold text-slate-950">{demo.title}</h4>
              <p class="mt-2 text-sm leading-relaxed text-slate-500">{demo.description}</p>
            </div>
          </article>
        ))}
      </div>

      <article class="mt-14 overflow-hidden rounded-3xl border border-blue-100 bg-[#f8fbff] shadow-xl shadow-blue-900/5">
        <div class="flex flex-col gap-6 border-b border-blue-100 p-7 sm:flex-row sm:items-end sm:justify-between sm:p-9">
          <div>
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-blue-600">{copy.report}</p>
            <h4 class="mt-3 max-w-2xl text-2xl font-semibold tracking-tight text-slate-950 sm:text-3xl">{copy.reportTitle}</h4>
            <p class="mt-4 max-w-2xl text-sm leading-relaxed text-slate-600">
              {copy.reportText}
            </p>
          </div>
          <a href="/media/feasibility-report.html" target="_blank" rel="noopener noreferrer" class="inline-flex flex-none items-center justify-center gap-2 rounded-full bg-blue-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-blue-700">
            {copy.reportCta} <span>↗</span>
          </a>
        </div>
        <div class="bg-slate-200 p-3 sm:p-5">
          <div class="overflow-hidden rounded-2xl border border-slate-300 bg-white shadow-inner">
            <iframe
              src="/media/feasibility-report.html"
              title={copy.reportFrame}
              class="h-[620px] w-full bg-white"
              loading="lazy"
              sandbox="allow-scripts"
              referrerpolicy="no-referrer"
            ></iframe>
          </div>
        </div>
      </article>
    </div>

    <div class="mt-24 grid gap-6 lg:grid-cols-[.9fr_1.1fr]">
      <div class="rounded-2xl border border-blue-100 bg-blue-50 p-7 sm:p-9">
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-blue-600">Architecture</p>
        <h3 class="mt-4 text-2xl font-semibold tracking-tight">{copy.architectureTitle}</h3>
        <p class="mt-4 leading-relaxed text-slate-600">
          {copy.architectureText}
        </p>
      </div>
      <div class="rounded-2xl border border-blue-100 bg-white p-5 shadow-xl shadow-blue-900/5 sm:p-7">
        <p class="mb-6 text-sm font-medium text-slate-500">{copy.flow}</p>
        <div class="grid items-stretch gap-3 sm:grid-cols-[1fr_auto_1.35fr_auto_1fr]">
          <div class="rounded-xl border border-cyan-200 bg-cyan-50 p-4">
            <span class="grid h-8 w-8 place-items-center rounded-full bg-cyan-500 font-mono text-xs font-semibold text-white">01</span>
            <p class="mt-4 font-semibold text-slate-950">{copy.question}</p>
            <p class="mt-1 text-xs leading-relaxed text-slate-500">{copy.questionText}</p>
          </div>
          <span class="hidden self-center text-xl text-blue-300 sm:block">→</span>
          <div class="rounded-xl border border-blue-200 bg-blue-50 p-4">
            <span class="grid h-8 w-8 place-items-center rounded-full bg-blue-600 font-mono text-xs font-semibold text-white">02</span>
            <p class="mt-4 font-semibold text-slate-950">{copy.agents}</p>
            <div class="mt-3 flex flex-wrap gap-1.5 text-[11px] text-blue-700">
              <span class="rounded-full bg-white px-2.5 py-1">{copy.network}</span>
              <span class="rounded-full bg-white px-2.5 py-1">{copy.route}</span>
              <span class="rounded-full bg-white px-2.5 py-1">{copy.simulation}</span>
            </div>
          </div>
          <span class="hidden self-center text-xl text-blue-300 sm:block">→</span>
          <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4">
            <span class="grid h-8 w-8 place-items-center rounded-full bg-emerald-500 font-mono text-xs font-semibold text-white">03</span>
            <p class="mt-4 font-semibold text-slate-950">{copy.answer}</p>
            <p class="mt-1 text-xs leading-relaxed text-slate-500">{copy.answerText}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLVideoElement>('video[data-playback-rate]').forEach((video) => {
    const rate = Number(video.dataset.playbackRate || '1');
    video.defaultPlaybackRate = rate;
    video.playbackRate = rate;
  });
</script>
