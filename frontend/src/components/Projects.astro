---
// Source : cv.md — section Projets

const projects = [
  {
    title: 'Prédiction de la consommation énergétique des bâtiments',
    context: 'Projet Kaggle',
    period: '04/2025 – 05/2025',
    description: 'Feature engineering avec Pandas/Seaborn, optimisation fine par GridSearchCV de modèles XGBoost et Random Forest.',
    tags: ['Python', 'XGBoost', 'Random Forest', 'Pandas', 'Scikit-learn'],
    // TODO: contenu à compléter — ajouter lien repo GitHub si disponible
    repo: null,
    demo: null,
  },
  {
    title: 'Pipeline Data Engineering — Scraping, stockage & visualisation',
    context: 'Projet académique',
    period: '11/2024 – 12/2024',
    description: 'Web scraping avec Scrapy, stockage MongoDB avec cache Redis, orchestration ELT, monitoring Kibana, dashboard Dash.',
    tags: ['Python', 'Scrapy', 'MongoDB', 'Redis', 'Kibana', 'Dash'],
    // TODO: contenu à compléter — ajouter lien repo GitHub si disponible
    repo: null,
    demo: null,
  },
];
---

<section id="projects" class="max-w-5xl mx-auto px-6 py-24">
  <h2 class="text-3xl font-bold mb-12 text-white">Projets</h2>
  <div class="grid md:grid-cols-2 gap-6">
    {projects.map((project) => (
      <article class="bg-gray-900 border border-gray-800 rounded-xl p-6 hover:border-indigo-700 transition-colors flex flex-col">
        <div class="flex items-start justify-between gap-4 mb-3">
          <div>
            <p class="text-xs text-gray-500 font-mono mb-1">{project.context} · {project.period}</p>
            <h3 class="text-white font-semibold leading-snug">{project.title}</h3>
          </div>
        </div>
        <p class="text-gray-400 text-sm leading-relaxed mb-4 flex-1">{project.description}</p>
        <div class="flex flex-wrap gap-2 mb-4">
          {project.tags.map((tag) => (
            <span class="text-xs px-2 py-1 bg-indigo-900/40 text-indigo-300 rounded border border-indigo-800/50">
              {tag}
            </span>
          ))}
        </div>
        <div class="flex gap-3">
          {project.repo && (
            <a
              href={project.repo}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-gray-400 hover:text-white transition-colors"
            >
              Repo →
            </a>
          )}
          {project.demo && (
            <a
              href={project.demo}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-gray-400 hover:text-white transition-colors"
            >
              Demo →
            </a>
          )}
        </div>
      </article>
    ))}
  </div>
</section>
