---
interface Props { lang?: 'fr' | 'en'; }
const { lang = 'fr' } = Astro.props;
const isEn = lang === 'en';

const projectsFr = [
  {
    title: 'Prédiction de la consommation énergétique des bâtiments',
    context: 'Projet Kaggle',
    period: '04/2025 à 05/2025',
    description: 'Analyse des données, création des variables les plus utiles, comparaison rigoureuse de plusieurs modèles puis optimisation des deux plus performants.',
    tags: ['Python', 'XGBoost', 'Random Forest', 'Pandas', 'Scikit-learn'],
    accent: 'orange',
  },
  {
    title: 'Chaîne de collecte, stockage et visualisation des données',
    context: 'Projet académique',
    period: '11/2024 à 12/2024',
    description: 'Application complète qui collecte automatiquement des données web, les stocke, accélère leur consultation, surveille leur qualité et les présente dans un tableau de bord.',
    tags: ['Python', 'Scrapy', 'MongoDB', 'Redis', 'Kibana', 'Dash'],
    accent: 'blue',
  },
];

const projectsEn = [
  { title: 'Building energy consumption prediction', context: 'Kaggle project', period: '04/2025 to 05/2025', description: 'Data analysis, feature engineering, rigorous comparison of several models and fine-tuning of the two best performers.', tags: ['Python', 'XGBoost', 'Random Forest', 'Pandas', 'Scikit-learn'], accent: 'orange' },
  { title: 'Data collection, storage and visualization pipeline', context: 'Academic project', period: '11/2024 to 12/2024', description: 'An end-to-end application that collects web data, stores it, speeds up queries, monitors quality and displays the results in a dashboard.', tags: ['Python', 'Scrapy', 'MongoDB', 'Redis', 'Kibana', 'Dash'], accent: 'blue' },
];

const projects = isEn ? projectsEn : projectsFr;
---

<section id="projects" class="border-b border-blue-100 bg-white px-6 py-24 text-slate-950 lg:px-10 lg:py-32">
  <div class="mx-auto max-w-7xl">
    <div class="flex items-end justify-between gap-8">
      <div>
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-blue-600">{isEn ? 'Selected work' : 'Sélection'}</p>
        <h2 class="mt-5 text-4xl font-semibold tracking-[-0.035em] sm:text-5xl">{isEn ? 'Other projects' : 'Autres projets'}</h2>
      </div>
      <a href="https://github.com/sonalain077" target="_blank" rel="noopener noreferrer" class="hidden text-sm font-medium text-blue-600 transition hover:text-blue-800 sm:block">{isEn ? 'View GitHub' : 'Voir GitHub'} →</a>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2">
      {projects.map((project, index) => (
        <article class="group relative overflow-hidden rounded-2xl border border-blue-100 bg-[#f8fbff] p-7 transition hover:-translate-y-1 hover:border-blue-300 hover:shadow-xl hover:shadow-blue-900/5 sm:p-9">
          <div class:list={['pointer-events-none absolute -right-20 -top-20 h-56 w-56 rounded-full blur-3xl', project.accent === 'orange' ? 'bg-orange-500/10' : 'bg-cyan-500/10']}></div>
          <div class="relative flex items-start justify-between gap-4">
            <div>
              <p class="font-mono text-xs uppercase tracking-[0.14em] text-slate-400">{project.context}, {project.period}</p>
              <h3 class="mt-5 max-w-lg text-2xl font-semibold leading-tight text-slate-950">{project.title}</h3>
            </div>
            <span class="font-mono text-3xl text-blue-100">0{index + 1}</span>
          </div>
          <p class="relative mt-8 max-w-xl text-sm leading-relaxed text-slate-600">{project.description}</p>
          <div class="relative mt-8 flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <span class="rounded-full border border-blue-100 bg-white px-3 py-1.5 text-xs text-slate-600">{tag}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
    <a href="https://github.com/sonalain077" target="_blank" rel="noopener noreferrer" class="mt-8 inline-block text-sm font-medium text-blue-600 transition hover:text-blue-800 sm:hidden">{isEn ? 'View GitHub' : 'Voir GitHub'} →</a>
  </div>
</section>
