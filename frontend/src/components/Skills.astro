---
interface Props { lang?: 'fr' | 'en'; }
const { lang = 'fr' } = Astro.props;
const isEn = lang === 'en';

const categoriesFr = [
  {
    label: 'Agents IA & IA générative',
    summary: 'Créer des assistants capables de collaborer, d’utiliser des outils et de vérifier leurs réponses.',
    items: ['LangGraph', 'LangChain', 'MCP', 'RAG', 'Routage des demandes', 'Agents avec outils'],
  },
  {
    label: 'Logiciel & données',
    summary: 'Relier l’IA à des bases de données et à des services fiables.',
    items: ['Python', 'FastAPI', 'GraphQL', 'PostgreSQL', 'Redis', 'SQL'],
  },
  {
    label: 'Apprentissage automatique',
    summary: 'Entraîner, comparer et mesurer des modèles avec méthode.',
    items: ['PyTorch', 'TensorFlow', 'Scikit-learn', 'XGBoost', 'Pandas', 'Evaluation'],
  },
  {
    label: 'Mise en production',
    summary: 'Transformer un prototype en application suivie, testée et déployable.',
    items: ['Docker', 'Kubernetes', 'CI/CD', 'Git', 'Linux', 'Monitoring'],
  },
];

const categoriesEn = [
  { label: 'AI agents and generative AI', summary: 'Build assistants that collaborate, use tools and verify their answers.', items: ['LangGraph', 'LangChain', 'MCP', 'RAG', 'Request routing', 'Tool-using agents'] },
  { label: 'Software and data', summary: 'Connect AI systems to databases and reliable services.', items: ['Python', 'FastAPI', 'GraphQL', 'PostgreSQL', 'Redis', 'SQL'] },
  { label: 'Machine learning', summary: 'Train, compare and evaluate models with a rigorous approach.', items: ['PyTorch', 'TensorFlow', 'Scikit-learn', 'XGBoost', 'Pandas', 'Evaluation'] },
  { label: 'Production', summary: 'Turn a prototype into a monitored, tested and deployable application.', items: ['Docker', 'Kubernetes', 'CI/CD', 'Git', 'Linux', 'Monitoring'] },
];

const categories = isEn ? categoriesEn : categoriesFr;
---

<section id="skills" class="border-b border-blue-100 bg-[#f7fbff] px-6 py-24 text-slate-950 lg:px-10 lg:py-32">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-10 lg:grid-cols-[.55fr_1fr] lg:gap-20">
      <div>
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-blue-600">{isEn ? 'Skills' : 'Compétences'}</p>
        <h2 class="mt-5 text-4xl font-semibold tracking-[-0.035em] sm:text-5xl">{isEn ? 'The tools I use.' : 'Les outils que j’utilise.'}</h2>
        <p class="mt-5 max-w-md leading-relaxed text-slate-600">{isEn ? 'I mainly work with AI agents, data and software development tools.' : 'Je travaille surtout avec des agents IA, des données et des outils de développement logiciel.'}</p>
      </div>
      <div class="grid gap-px overflow-hidden rounded-2xl border border-blue-100 bg-blue-100 shadow-xl shadow-blue-900/5 sm:grid-cols-2">
        {categories.map((cat, index) => (
          <article class="bg-white p-7">
            <div class="flex items-center justify-between">
              <h3 class="font-semibold text-slate-950">{cat.label}</h3>
              <span class="font-mono text-xs text-blue-200">0{index + 1}</span>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-slate-500">{cat.summary}</p>
            <div class="mt-6 flex flex-wrap gap-2">
              {cat.items.map((item) => (
                <span class="rounded-full border border-blue-100 bg-blue-50 px-3 py-1.5 text-xs font-medium text-blue-700">{item}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
      <p class="mt-5 text-xs leading-relaxed text-slate-500 sm:col-start-2">
        {isEn
          ? 'In simple terms: an LLM understands and generates text; RAG helps it retrieve reliable information; MCP provides a standard way to use external tools.'
          : 'En clair : un LLM est un modèle capable de comprendre et générer du texte ; le RAG lui permet de rechercher des informations fiables ; MCP lui donne un cadre standard pour utiliser des outils externes.'}
      </p>
    </div>
  </div>
</section>
